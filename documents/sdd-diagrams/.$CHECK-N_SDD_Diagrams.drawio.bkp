<mxfile host="app.diagrams.net"><diagram name="00 - Legend" id="00-legend"><mxGraphModel dx="1660" dy="1120" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1420" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t11" value="CHECK-N — Diagram Legend &amp; Notation Conventions" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#1f2933;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="24" y="26" width="1602" height="28" as="geometry"/></mxCell><mxCell id="t12" value="Defined once here (SDD 1.7.1 / Appendix B) and applied consistently across every page in this file." style="text;html=1;fontSize=12;fontStyle=0;fontColor=#5a6b7b;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="24" y="48" width="1602" height="28" as="geometry"/></mxCell><mxCell id="gA" value="A.  LINES &amp; ARROWS" style="rounded=1;arcSize=4;fillColor=#f8fafc;strokeColor=#cbd5e1;dashed=1;dashPattern=6 4;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#5a6b7b;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="780" height="420" as="geometry"/></mxCell><mxCell id="lnA1" value="" style="html=1;strokeColor=#475569;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#1f2933;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="90" y="160" as="sourcePoint"/><mxPoint x="230" y="160" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lnA1_t" value="Solid arrow" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#1f2933;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="142" width="220" height="20" as="geometry"/></mxCell><mxCell id="lnA1_d" value="Synchronous call / request-response, or a direct data flow the caller waits on." style="text;html=1;fontSize=10;fontColor=#5a6b7b;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="162" width="530" height="40" as="geometry"/></mxCell><mxCell id="lnA2" value="" style="html=1;strokeColor=#475569;strokeWidth=1.5;endArrow=blockThin;endFill=1;fontSize=10;fontColor=#1f2933;labelBackgroundColor=#ffffff;dashed=1;dashPattern=4 3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="90" y="250" as="sourcePoint"/><mxPoint x="230" y="250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lnA2_t" value="Dashed arrow" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#1f2933;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="232" width="220" height="20" as="geometry"/></mxCell><mxCell id="lnA2_d" value="Asynchronous response, push notification, or an event/callback the sender does not block on." style="text;html=1;fontSize=10;fontColor=#5a6b7b;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="252" width="530" height="40" as="geometry"/></mxCell><mxCell id="lnA3box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5a6b7b;strokeWidth=2;dashed=1;dashPattern=1 3;" vertex="1" parent="1"><mxGeometry x="90" y="340" width="140" height="60" as="geometry"/></mxCell><mxCell id="lnA3_t" value="Dotted boundary" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#1f2933;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="340" width="220" height="20" as="geometry"/></mxCell><mxCell id="lnA3_d" value="Trust or system boundary. Crossing it crosses a security, deployment, or ownership line." style="text;html=1;fontSize=10;fontColor=#5a6b7b;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="360" width="530" height="40" as="geometry"/></mxCell><mxCell id="gA_note" value="Include / extend / depends-on relationships are labelled explicitly on the arrow&lt;br/&gt;(e.g. &lt;&lt;include&gt;&gt;, &lt;&lt;extend&gt;&gt;) rather than relying on line style alone." style="text;html=1;fontSize=9;fontColor=#9a6700;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="430" width="690" height="34" as="geometry"/></mxCell><mxCell id="gB" value="B.  SHAPES" style="rounded=1;arcSize=4;fillColor=#f8fafc;strokeColor=#cbd5e1;dashed=1;dashPattern=6 4;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#5a6b7b;" vertex="1" parent="1"><mxGeometry x="860" y="100" width="780" height="420" as="geometry"/></mxCell><mxCell id="shB1" value="" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#e8f1fa;strokeColor=#1668b3;fontSize=11;fontStyle=1;fontColor=#1f2933;" vertex="1" parent="1"><mxGeometry x="890" y="140" width="70" height="76" as="geometry"/></mxCell><mxCell id="shB1_t" value="Actor" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#1f2933;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1010" y="146" width="220" height="18" as="geometry"/></mxCell><mxCell id="shB1_d" value="A human user or role (Employee, Supervisor, HR/Admin)." style="text;html=1;fontSize=10;fontColor=#5a6b7b;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1010" y="166" width="590" height="40" as="geometry"/></mxCell><mxCell id="shB2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f1fa;strokeColor=#1668b3;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="890" y="248" width="90" height="40" as="geometry"/></mxCell><mxCell id="shB2_t" value="CHECK-N component" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#1f2933;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1010" y="250" width="260" height="18" as="geometry"/></mxCell><mxCell id="shB2_d" value="Rounded/plain box, blue fill -- a CHECK-N-owned component (mobile, backend, or dashboard code we built)." style="text;html=1;fontSize=10;fontColor=#5a6b7b;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1010" y="270" width="590" height="40" as="geometry"/></mxCell><mxCell id="shB3" value="" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="890" y="328" width="90" height="55" as="geometry"/></mxCell><mxCell id="shB3_t" value="External / cloud service" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#1f2933;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1010" y="330" width="260" height="18" as="geometry"/></mxCell><mxCell id="shB3_d" value="Cloud shape, slate fill -- outside CHECK-N&#x27;s deployment boundary (Firebase, SMTP, native OS APIs)." style="text;html=1;fontSize=10;fontColor=#5a6b7b;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1010" y="350" width="590" height="45" as="geometry"/></mxCell><mxCell id="shB4" value="" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fdf6e3;strokeColor=#9a6700;strokeWidth=2;fontSize=11;align=center;verticalAlign=middle;boundedLbl=1;" vertex="1" parent="1"><mxGeometry x="890" y="420" width="90" height="60" as="geometry"/></mxCell><mxCell id="shB4_t" value="Persistent storage" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#1f2933;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1010" y="430" width="260" height="18" as="geometry"/></mxCell><mxCell id="shB4_d" value="Cylinder -- a Firestore collection, or Redis." style="text;html=1;fontSize=10;fontColor=#5a6b7b;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1010" y="450" width="590" height="30" as="geometry"/></mxCell><mxCell id="gC" value="C.  COLOUR KEY  (fill = category, applies across all pages)" style="rounded=1;arcSize=4;fillColor=#f8fafc;strokeColor=#cbd5e1;dashed=1;dashPattern=6 4;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#5a6b7b;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="780" height="420" as="geometry"/></mxCell><mxCell id="ck0" value="" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#e8f1fa;strokeColor=#1668b3;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="615" width="70" height="36" as="geometry"/></mxCell><mxCell id="ck0_t" value="Client / mobile-owned element" style="text;html=1;fontSize=11;fontColor=#5a6b7b;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="170" y="621" width="610" height="24" as="geometry"/></mxCell><mxCell id="ck1" value="" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#e6f4ee;strokeColor=#137a54;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="680" width="70" height="36" as="geometry"/></mxCell><mxCell id="ck1_t" value="Dashboard, approval, or success path" style="text;html=1;fontSize=11;fontColor=#5a6b7b;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="170" y="686" width="610" height="24" as="geometry"/></mxCell><mxCell id="ck2" value="" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#fdf6e3;strokeColor=#9a6700;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="745" width="70" height="36" as="geometry"/></mxCell><mxCell id="ck2_t" value="Security, guard, session, or caution" style="text;html=1;fontSize=11;fontColor=#5a6b7b;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="170" y="751" width="610" height="24" as="geometry"/></mxCell><mxCell id="ck3" value="" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#fdeaec;strokeColor=#C8102E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="810" width="70" height="36" as="geometry"/></mxCell><mxCell id="ck3_t" value="Core decision logic / critical path" style="text;html=1;fontSize=11;fontColor=#5a6b7b;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="170" y="816" width="610" height="24" as="geometry"/></mxCell><mxCell id="ck4" value="" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="875" width="70" height="36" as="geometry"/></mxCell><mxCell id="ck4_t" value="Generic, infrastructure, or external" style="text;html=1;fontSize=11;fontColor=#5a6b7b;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="170" y="881" width="610" height="24" as="geometry"/></mxCell><mxCell id="gD" value="D.  STEREOTYPES / NOTATION EXTENSIONS  (SDD 1.7.1)" style="rounded=1;arcSize=4;fillColor=#f8fafc;strokeColor=#cbd5e1;dashed=1;dashPattern=6 4;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#5a6b7b;" vertex="1" parent="1"><mxGeometry x="860" y="560" width="780" height="420" as="geometry"/></mxCell><mxCell id="st0_s" value="&lt;&lt;service&gt;&gt;" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#1f2933;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="890" y="610" width="220" height="18" as="geometry"/></mxCell><mxCell id="st0_a" value="Backend service class" style="text;html=1;fontSize=9;fontColor=#5a6b7b;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="890" y="630" width="220" height="34" as="geometry"/></mxCell><mxCell id="st0_m" value="Encapsulates business logic behind a defined interface; injected via NestJS DI. See class-diagram (SRS) and FIG-003-B." style="text;html=1;fontSize=9;fontColor=#5a6b7b;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1120" y="610" width="480" height="60" as="geometry"/></mxCell><mxCell id="st1_s" value="&lt;&lt;external&gt;&gt;" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#1f2933;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="890" y="700" width="220" height="18" as="geometry"/></mxCell><mxCell id="st1_a" value="Third-party / cloud dependency" style="text;html=1;fontSize=9;fontColor=#5a6b7b;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="890" y="720" width="220" height="34" as="geometry"/></mxCell><mxCell id="st1_m" value="Outside CHECK-N&#x27;s own deployment boundary; contract-only, not modifiable by us (Firebase, FCM, SMTP)." style="text;html=1;fontSize=9;fontColor=#5a6b7b;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1120" y="700" width="480" height="60" as="geometry"/></mxCell><mxCell id="st2_s" value="&lt;&lt;repository&gt;&gt;" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#1f2933;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="890" y="790" width="220" height="18" as="geometry"/></mxCell><mxCell id="st2_a" value="Data-access adapter class" style="text;html=1;fontSize=9;fontColor=#5a6b7b;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="890" y="810" width="220" height="34" as="geometry"/></mxCell><mxCell id="st2_m" value="The sole point of read/write access to a persistent store (e.g. FirestoreRepository). Only this layer writes to Firestore." style="text;html=1;fontSize=9;fontColor=#5a6b7b;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1120" y="790" width="480" height="60" as="geometry"/></mxCell><mxCell id="st3_s" value="&lt;&lt;guard&gt;&gt; / &lt;&lt;pipe&gt;&gt;" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#1f2933;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="890" y="880" width="220" height="18" as="geometry"/></mxCell><mxCell id="st3_a" value="NestJS request-pipeline class" style="text;html=1;fontSize=9;fontColor=#5a6b7b;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="890" y="900" width="220" height="34" as="geometry"/></mxCell><mxCell id="st3_m" value="Enforces identity, session validity, or payload validation before a controller handler runs." style="text;html=1;fontSize=9;fontColor=#5a6b7b;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1120" y="880" width="480" height="60" as="geometry"/></mxCell><mxCell id="gE" value="E.  C4 NOTATION  (System Context, page 01, and Container, page 03)" style="rounded=1;arcSize=4;fillColor=#f8fafc;strokeColor=#cbd5e1;dashed=1;dashPattern=6 4;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#5a6b7b;" vertex="1" parent="1"><mxGeometry x="40" y="1020" width="1600" height="240" as="geometry"/></mxCell><mxCell id="gE_note" value="Person, Software System, Container, Component, Database and Relationship shapes are the official draw.io C4 shape library, used unmodified. Each C4 page also carries this same legend block embedded at its foot for standalone readability." style="text;html=1;fontSize=10;fontColor=#5a6b7b;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="1050" width="1540" height="34" as="geometry"/></mxCell><mxCell id="c4legend" connectable="0" parent="1" style="group" value="" vertex="1"><mxGeometry height="140" width="900" x="390" y="1110" as="geometry"/></mxCell><mxCell id="c4legend-bg" parent="c4legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;dashPattern=1 2;fontColor=#666666;" value="" vertex="1"><mxGeometry height="140" width="900" as="geometry"/></mxCell><mxCell id="c4legend-title" parent="c4legend" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontColor=#666666;" value="Legend" vertex="1"><mxGeometry height="20" width="50" x="15" y="8" as="geometry"/></mxCell><object placeholders="1" c4Name="Person" c4Type="Person" c4Description="Description" label="&lt;b&gt;%c4Name%&lt;/b&gt;&lt;div&gt;[%c4Type%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;%c4Description%&lt;/div&gt;" id="c4legend-s0"><mxCell parent="c4legend" style="html=1;whiteSpace=wrap;fillColor=#08427b;strokeColor=none;fontColor=#ffffff;align=center;shape=mxgraph.c4.person;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];fontSize=9;metaEdit=1;meta