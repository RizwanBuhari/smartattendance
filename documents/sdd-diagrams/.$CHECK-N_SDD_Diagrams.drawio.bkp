dth="140" as="geometry"><mxPoint x="730" y="75" as="sourcePoint"/><mxPoint x="870" y="75" as="targetPoint"/></mxGeometry></mxCell><mxCell id="nFooter" value="Notation &amp; tooling (SDD 1.7): UML 2.5 (Draw.io / diagrams.net) for class, sequence, state, activity, component and composite structure diagrams; C4 model for context and container levels; crow&#x27;s-foot style for the Firestore ERD; plain flowcharts for algorithms and pipelines. Editable source for every diagram in this register lives in this single file, CHECK-N_SDD_Diagrams.drawio, one page per figure." style="rounded=1;arcSize=6;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=1;html=1;whiteSpace=wrap;fontSize=10;fontColor=#5a6b7b;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="40" y="1300" width="1600" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="01 - System Context" id="01-system-context"><mxGraphModel dx="1660" dy="1120" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t11" value="CHECK-N — System Context Diagram  (FIG-015, C4 Level 1)" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#1f2933;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="24" y="26" width="1452" height="28" as="geometry"/></mxCell><mxCell id="t12" value="The system boundary and every external actor/system it exchanges data with. No internal structure is shown -- see FIG-016 for the container decomposition." style="text;html=1;fontSize=12;fontStyle=0;fontColor=#5a6b7b;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="24" y="48" width="1452" height="28" as="geometry"/></mxCell><object placeholders="1" c4Name="Employee" c4Type="Person" c4Description="Records own attendance" label="&lt;b&gt;%c4Name%&lt;/b&gt;&lt;div&gt;[%c4Type