<mxfile host="app.diagrams.net"><diagram name="Page-1"><mxGraphModel dx="2100" dy="1062" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1062" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="f40" value="Smart Attendance &amp; Geofencing  —  Firestore Data Model" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#1f2933;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="24" y="26" width="2040" height="28" as="geometry"/></mxCell><mxCell id="f62" value="All 16 collections as written by the code.  Timestamps are stored in UTC; tzOffsetMinutes exists only so clients can render local time.        PK = document id.      Every foreign key is annotated inline as  FK field -&gt; collection;  lines are drawn only for the structural spine, because Firestore has no joins and 12 crossing arrows read worse than the annotations do." style="text;html=1;fontSize=12;fontStyle=0;fontColor=#5a6b7b;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="24" y="48" width="2040" height="28" as="geometry"/></mxCell><mxCell id="b0" value="IDENTITY  ·  ACCESS  ·  SESSIONS" style="rounded=1;arcSize=4;fillColor=#f8fafc;strokeColor=#cbd5e1;dashed=1;dashPattern=6 4;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#5a6b7b;" vertex="1" parent="1"><mxGeometry x="40" y="92" width="430" height="920" as="geometry"/></mxCell><mxCell id="codes" value="&lt;b style=&quot;font-size:12px;color:#1f2933&quot;&gt;company_Codes&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;PK  id&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;code            8-char, single use&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;FK  employeeId  -&amp;gt; employees_ids  (nullable)&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;used            boolean&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;createdAt  ·  usedAt&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#e6f4ee;strokeColor=#137a54;strokeWidth=1;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="56" y="124" width="398" height="104" as="geometry"/></mxCell><mxCell id="creq" value="&lt;b style=&quot;font-size:12px;color:#1f2933&quot;&gt;code_Requests&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;PK  employeeId  -&amp;gt; employees_ids&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;    (doc id IS the employee: one open&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;     request per person, by construction)&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;employeeName&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;FK  locationId  -&amp;gt; locations_ids&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;locationName&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;requestedAt     employee tapped &amp;quot;request&amp;quot;&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;issuedAt        site admin generated a code&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;notifiedAt      push throttle, kept separate&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#e6f4ee;strokeColor=#137a54;strokeWidth=1;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="56" y="246" width="398" height="154" as="geometry"/></mxCell><mxCell id="dtok" value="&lt;b style=&quot;font-size:12px;color:#1f2933&quot;&gt;device_Tokens&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;PK  token       the FCM registration token&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;FK  employeeId  -&amp;gt; employees_ids&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;platform  ·  updatedAt&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#e6f4ee;strokeColor=#137a54;strokeWidth=1;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="56" y="418" width="398" height="79" as="geometry"/></mxCell><mxCell id="esess" value="&lt;b style=&quot;font-size:12px;color:#1f2933&quot;&gt;employee_Sessions&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;PK  employeeId  -&amp;gt; employees_ids&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;sessionId       server-minted at login&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;employeeId  ·  name  ·  updatedAt&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;One account, one device: the phone sends&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;sessionId as X-Session-Id and watches this&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;doc. A newer login overwrites it, so the&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;older device sees the mismatch and signs&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;itself out. Eviction is server-driven.&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#fdf6e3;strokeColor=#9a6700;strokeWidth=2;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="56" y="515" width="398" height="154" as="geometry"/></mxCell><mxCell id="ausers" value="&lt;b style=&quot;font-size:12px;color:#1f2933&quot;&gt;admin_Users&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;PK  id&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;email           login identity&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;displayName  ·  phone  ·  jobTitle&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;photoBase64&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#e8f1fa;strokeColor=#1668b3;strokeWidth=1;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="56" y="687" width="398" height="92" as="geometry"/></mxCell><mxCell id="asess" value="&lt;b style=&quot;font-size:12px;color:#1f2933&quot;&gt;admin_Sessions&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;PK  uid         admin Firebase UID&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;sessionId  ·  email  ·  updatedAt&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;Dashboard mirror of employee_Sessions.&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#e8f1fa;strokeColor=#1668b3;strokeWidth=1;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="56" y="797" width="398" height="79" as="geometry"/></mxCell><mxCell id="b7" value="CORE  —  WHO  and  WHERE" style="rounded=1;arcSize=4;fillColor=#f8fafc;strokeColor=#cbd5e1;dashed=1;dashPattern=6 4;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#5a6b7b;" vertex="1" parent="1"><mxGeometry x="490" y="92" width="470" height="920" as="geometry"/></mxCell><mxCell id="emp" value="&lt;b style=&quot;font-size:12px;color:#1f2933&quot;&gt;employees_ids&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;PK  id&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;name  ·  email  ·  nationality  ·  photoBase64&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;status              [ active | disabled ]&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;role                office_employee | site_employee |&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;                    site_supervisor | siteAdmin&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;authUid             Firebase UID (optional)&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;                    absent until they register&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;companyId&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;FK  assignedLocationIds[]  -&amp;gt; locations_ids&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;                    the geofences that apply to them;&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;                    empty = any approved location&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;FK  supervisorId    -&amp;gt; employees_ids  (self-ref)&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;supervisorName&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;attendanceMethod    geofence | biometric_geofence |&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;                    biometric&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;biometricRequired  ·  biometricSetupCompleted&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;biometricDeviceId  ·  biometricDeviceName&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;biometricActivatedAt  ·  biometricResetAt&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#fdeaec;strokeColor=#C8102E;strokeWidth=2;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="506" y="124" width="438" height="267" as="geometry"/></mxCell><mxCell id="loc" value="&lt;b style=&quot;font-size:12px;color:#1f2933&quot;&gt;locations_ids&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;PK  id&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;name&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;latitude   ·  longitude      geofence centre&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;radiusMeters                 allowed radius&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;type              [ site | office ]&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;                  absent is treated as office&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;radiusMeters is the figure EVERY check-in is&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;measured against. Editing it takes effect on&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;the next check-in (Redis cache invalidated on&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;write, 60s TTL otherwise).&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#fdeaec;strokeColor=#C8102E;strokeWidth=2;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="506" y="413" width="438" height="179" as="geometry"/></mxCell><mxCell id="note" value="&lt;b style=&quot;font-size:12px;color:#1f2933&quot;&gt;Two inconsistencies worth fixing&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;attendance_meta  vs  attendance_UTCM&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;   attendance.service.ts writes shift metadata to&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;   attendance_meta; offsite-checkin.service.ts writes&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;   the same kind of metadata to attendance_UTCM.&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;   Two collections for one purpose — pick one.&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;role_audit_logs  vs  role_audits&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;   employees.service.ts writes BOTH on every role&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;   change, the second &amp;quot;for backwards compatibility&amp;quot;.&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;   Drop role_audits once nothing reads it.&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#fdf6e3;strokeColor=#9a6700;strokeWidth=1;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="506" y="614" width="438" height="186" as="geometry"/></mxCell><mxCell id="b11" value="ATTENDANCE  —  THE RECORD" style="rounded=1;arcSize=4;fillColor=#f8fafc;strokeColor=#cbd5e1;dashed=1;dashPattern=6 4;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#5a6b7b;" vertex="1" parent="1"><mxGeometry x="980" y="92" width="530" height="920" as="geometry"/></mxCell><mxCell id="att" value="&lt;b style=&quot;font-size:12px;color:#1f2933&quot;&gt;attendance_ids&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;PK  id&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;FK  employeeId    -&amp;gt; employees_ids.authUid  OR  .id&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;                     (both are valid keys — see note)&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;employeeName  ·  deviceId&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;checkInUtc         UTC ISO-8601&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;checkOutUtc        UTC ISO-8601  (null while open)&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;tzOffsetMinutes    device offset, for display only&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;checkInCoords      { lat, lng }&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;checkOutCoords     { lat, lng }&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;gpsAccuracy        metres&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;FK  locationId     -&amp;gt; locations_ids&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;locationName&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;status             [ checked_in | checked_out |&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;                     rejected ]&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;verification {                     &amp;lt;- server verdict&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;   distanceMeters, radiusMeters,&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;   accuracyBufferApplied, reason,&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;   clientClaimedInside,&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;   clientDisagreed,   &amp;lt;- fraud signal&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;   isDwellConfirmed, verifiedBy }&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;checkOutVerification { ...same... }&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;checkoutFlagged  ·  checkoutDistanceMeters&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;checkoutReview {&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;   status [ pending | accepted | rejected ],&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;   requestedAt, coords, distanceMeters,&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;   locationName, resolvedAt, resolvedBy,&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;   rejectionReason }&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;approvedBy  ·  approvedAt&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#fdeaec;strokeColor=#C8102E;strokeWidth=2;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="996" y="124" width="498" height="429" as="geometry"/></mxCell><mxCell id="meta" value="&lt;b style=&quot;font-size:12px;color:#1f2933&quot;&gt;attendance_meta       (backend only)&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;PK  id            same id as the attendance doc&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;employeeId&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;checkInUtc   ·  checkInUtcMs     epoch millis&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;checkOutUtc  ·  checkOutUtcMs&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;Never returned by the API and never subscribed&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;to by the dashboard. Exists so the backend can&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;sort and window by number rather than by string.&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=1;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="996" y="573" width="498" height="142" as="geometry"/></mxCell><mxCell id="utcm" value="&lt;b style=&quot;font-size:12px;color:#1f2933&quot;&gt;attendance_UTCM       (duplicate — see note)&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;Same shape as attendance_meta, written only by&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;offsite-checkin.service.ts.&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#fdf6e3;strokeColor=#9a6700;strokeWidth=1;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="996" y="733" width="498" height="67" as="geometry"/></mxCell><mxCell id="b15" value="EVIDENCE  —  CONTINUOUS VERIFICATION" style="rounded=1;arcSize=4;fillColor=#f8fafc;strokeColor=#cbd5e1;dashed=1;dashPattern=6 4;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#5a6b7b;" vertex="1" parent="1"><mxGeometry x="1530" y="92" width="530" height="920" as="geometry"/></mxCell><mxCell id="gev" value="&lt;b style=&quot;font-size:12px;color:#1f2933&quot;&gt;geofence_Events&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;PK  id&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;FK  employeeId     -&amp;gt; employees_ids.authUid&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;FK  employeeDocId  -&amp;gt; employees_ids.id&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;employeeName  ·  deviceId&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;FK  locationId     -&amp;gt; locations_ids&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;locationName&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;eventType    [ ENTER | DWELL | EXIT | RETURN ]&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;timestamp&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;enteredAt  ·  dwellConfirmedAt  ·  exitedAt&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;totalInsideDurationSeconds&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;FK  attendanceId   -&amp;gt; attendance_ids&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;source             NATIVE_GEOFENCE&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;isBrief            left before DWELL confirmed&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;latitude  ·  longitude  ·  gpsAccuracy&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;reason  ·  reasonSubmittedAt      employee note&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;serverCheck {                &amp;lt;- claim cross-check&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;   distanceMeters, radiusMeters,&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;   serverSaysInside,&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;   contradictsClaim,  &amp;lt;- ENTER from 4km away&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;   reason }&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#e8f1fa;strokeColor=#1668b3;strokeWidth=2;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1546" y="124" width="498" height="304" as="geometry"/></mxCell><mxCell id="ping" value="&lt;b style=&quot;font-size:12px;color:#1f2933&quot;&gt;location_Pings&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;PK  id&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;FK  employeeId  -&amp;gt; employees_ids&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;employeeName  ·  timestamp  ·  tzOffsetMinutes&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;lat  ·  lng  ·  gpsAccuracy&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;insideGeofence     server-computed&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;locationName  ·  distanceMeters  ·  radiusMeters&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;reason             the geofence verdict&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;inconclusive       fix too poor to judge&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;inconclusive is why a weak indoor signal does&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;NOT read as absence: those pings are stored but&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;skipped when flagging a shift.&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#e8f1fa;strokeColor=#1668b3;strokeWidth=2;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1546" y="448" width="498" height="192" as="geometry"/></mxCell><mxCell id="off" value="&lt;b style=&quot;font-size:12px;color:#1f2933&quot;&gt;offsite_requests&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;PK  id&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;companyId&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;FK  employeeId    -&amp;gt; employees_ids&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;employeeUid  ·  employeeName  ·  employeeRole&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;FK  supervisorId  -&amp;gt; employees_ids&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;supervisorUid  ·  supervisorName&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;FK  worksiteId    -&amp;gt; locations_ids&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;worksiteName&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;requestType   [ check_in | check_out ]&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;status        [ pending_approval |&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;                approved_waiting_qr | qr_ready |&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;                completed | rejected | cancelled ]&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;reason&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;requestedAt  ·  createdAt  ·  updatedAt&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#e6f4ee;strokeColor=#137a54;strokeWidth=1;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1546" y="658" width="498" height="217" as="geometry"/></mxCell><mxCell id="raudit" value="&lt;b style=&quot;font-size:12px;color:#1f2933&quot;&gt;role_audit_logs      (+ legacy role_audits)&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;PK  id&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;FK  employeeId  -&amp;gt; employees_ids&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;employeeName&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;changedBy       verified admin email&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;changedAt  ·  previousRole  ·  newRole&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=1;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRi