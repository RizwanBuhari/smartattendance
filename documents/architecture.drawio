<mxfile host="app.diagrams.net"><diagram name="Page-1"><mxGraphModel dx="1660" dy="1120" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1660" pageHeight="1120" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="f40" value="Smart Attendance &amp; Geofencing  —  System Architecture" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#1f2933;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="24" y="26" width="1600" height="28" as="geometry"/></mxCell><mxCell id="f62" value="Presence is decided server-side: the device reports coordinates, the backend measures them.   El Sewedy Electric UAE  ·  Summer Internship Project" style="text;html=1;fontSize=12;fontStyle=0;fontColor=#5a6b7b;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="24" y="48" width="1600" height="28" as="geometry"/></mxCell><mxCell id="b0" value="CLIENTS" style="rounded=1;arcSize=4;fillColor=#f8fafc;strokeColor=#cbd5e1;dashed=1;dashPattern=6 4;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#5a6b7b;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1580" height="236" as="geometry"/></mxCell><mxCell id="mob" value="&lt;b style=&quot;font-size:12px;color:#1f2933&quot;&gt;Flutter Mobile App&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;Roles:  employee  ·  site supervisor  ·  site admin&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;native_geofence   OS geofence per approved location;&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;                  ENTER / DWELL (5 min) / EXIT / RETURN&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;geolocator        GPS fix + accuracy radius&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;WorkManager       drains the offline event queue&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;SessionGuard      holds X-Session-Id; self-evicts&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;FCM receive  ·  flutter_local_notifications&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#e8f1fa;strokeColor=#1668b3;strokeWidth=2;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="66" y="122" width="470" height="186" as="geometry"/></mxCell><mxCell id="dash" value="&lt;b style=&quot;font-size:12px;color:#1f2933&quot;&gt;React Admin Dashboard  (Vite)&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;Overview · Attendance · Locations · Employees&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;Reports · Review · Profile&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;Leaflet + leaflet.heat   maps and location heat-map&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;Firestore onSnapshot     live tables, no polling&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;ExcelJS                  timesheet export&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;AuthContext              single admin session&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#e6f4ee;strokeColor=#137a54;strokeWidth=2;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="566" y="122" width="440" height="186" as="geometry"/></mxCell><mxCell id="key" value="&lt;b style=&quot;font-size:12px;color:#1f2933&quot;&gt;Trust model&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;The backend Admin SDK is the ONLY writer to Firestore.&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;Solid arrows  = REST over HTTPS with a Firebase bearer token.&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;Dashed arrows = direct Firestore reads, for live UI only.&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;Clients read the database directly so tables and maps update&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;live, but EVERY mutation goes through the API — otherwise the&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;geofence, the guards and the field whitelist could be bypassed.&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;firestore.rules enforces read-only at the database itself.&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=1;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1036" y="122" width="558" height="186" as="geometry"/></mxCell><mxCell id="b4" value="APPLICATION  —  NestJS   (the only trusted writer)" style="rounded=1;arcSize=4;fillColor=#f8fafc;strokeColor=#cbd5e1;dashed=1;dashPattern=6 4;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#5a6b7b;" vertex="1" parent="1"><mxGeometry x="40" y="356" width="1580" height="344" as="geometry"/></mxCell><mxCell id="guard" value="&lt;b style=&quot;font-size:12px;color:#1f2933&quot;&gt;STEP 1 · Guards&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;EmployeeGuard   identity taken from the TOKEN,&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;                never from the request body&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;AdminGuard      + verified admin email for audit&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;X-Session-Id    superseded id  =&amp;gt;  401&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;                (one account, one device)&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#fdf6e3;strokeColor=#9a6700;strokeWidth=1;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="66" y="392" width="350" height="138" as="geometry"/></mxCell><mxCell id="pipe" value="&lt;b style=&quot;font-size:12px;color:#1f2933&quot;&gt;STEP 2 · GeoPayloadPipe&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;lat / lng finite and in range; not (0,0)&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;accuracy &amp;gt;= 0 ; timestamp skew bounded&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;WHITELIST  strips every undeclared field&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;(status, checkoutFlagged, employeeId, ...)&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#fdf6e3;strokeColor=#9a6700;strokeWidth=1;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="442" y="392" width="350" height="138" as="geometry"/></mxCell><mxCell id="geo" value="&lt;b style=&quot;font-size:12px;color:#1f2933&quot;&gt;STEP 3 · GeofenceService   [ the decision ]&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;haversine distance to EVERY approved location;&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;the NEAREST one wins&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;accuracy ceiling 50m  (else poor_accuracy)&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;boundary buffer  min(accuracy, 25m)&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;inside  =  distance &amp;lt;= radius + buffer&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#fdeaec;strokeColor=#C8102E;strokeWidth=2;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="818" y="392" width="380" height="138" as="geometry"/></mxCell><mxCell id="verdict" value="&lt;b style=&quot;font-size:12px;color:#1f2933&quot;&gt;STEP 4 · Verdict persisted&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;distanceMeters · radiusMeters · reason&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;clientDisagreed   the phone claimed inside,&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;                  the server measured otherwise&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;inconclusive      poor fix is NOT absence&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#fdeaec;strokeColor=#C8102E;strokeWidth=1;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1224" y="392" width="370" height="138" as="geometry"/></mxCell><mxCell id="mods" value="&lt;b style=&quot;font-size:12px;color:#1f2933&quot;&gt;Feature modules&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;attendance   check-in/out, worked hours, checkout reviews          geofence-events   native ENTER / DWELL / EXIT / RETURN          location-pings   periodic samples&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;locations   sites + radii, Redis-cached 60s          employees   records, roles, assignments          auth   login / register, session minting          admins   dashboard accounts&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;company-codes   single-use invites          offsite-checkin   supervisor QR approval          otp   site-admin codes          biometrics   device enrolment          push   FCM fan-out&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;mail   SMTP invites          redis   cache client          Swagger   /api/docs  +  /api/docs-json  (61 operations, 13 tags)&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=1;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="66" y="556" width="1528" height="104" as="geometry"/></mxCell><mxCell id="b10" value="PLATFORM  —  Firebase  &amp;  Redis" style="rounded=1;arcSize=4;fillColor=#f8fafc;strokeColor=#cbd5e1;dashed=1;dashPattern=6 4;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#5a6b7b;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="1580" height="244" as="geometry"/></mxCell><mxCell id="fs" value="&lt;b style=&quot;font-size:12px;color:#1f2933&quot;&gt;Cloud Firestore   (16 collections)&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;employees_ids · locations_ids · attendance_ids&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;attendance_meta · geofence_Events · location_Pings&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;company_Codes · code_Requests · offsite_requests&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;device_Tokens · employee_Sessions · admin_Sessions&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;admin_Users · role_audit_logs&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;System of record. Written only through the Admin SDK.&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;Read directly by both clients; firestore.rules keeps&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;that access read-only.&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#fdf6e3;strokeColor=#9a6700;strokeWidth=2;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="66" y="764" width="452" height="194" as="geometry"/></mxCell><mxCell id="redis" value="&lt;b style=&quot;font-size:12px;color:#1f2933&quot;&gt;Redis&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;locations:all             60s TTL&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;auth:employee:&amp;lt;uid&amp;gt;       guard cache&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;auth:admin:&amp;lt;email&amp;gt;        verify cache&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;offsite QR / OTP tokens   single-use&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;Fails SAFE: a down Redis reports&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;connected:false and the app carries on&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;serving from Firestore.&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=1;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="544" y="764" width="316" height="194" as="geometry"/></mxCell><mxCell id="fbauth" value="&lt;b style=&quot;font-size:12px;color:#1f2933&quot;&gt;Firebase Auth&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;Email / password identity.&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;ID tokens verified by both&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;guards on every request.&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#fdf6e3;strokeColor=#9a6700;strokeWidth=1;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="886" y="764" width="246" height="90" as="geometry"/></mxCell><mxCell id="idtk" value="&lt;b style=&quot;font-size:12px;color:#1f2933&quot;&gt;Identity Toolkit&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;Password verification for&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;POST /auth/login — the&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;Admin SDK cannot do it.&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#fdf6e3;strokeColor=#9a6700;strokeWidth=1;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="886" y="868" width="246" height="90" as="geometry"/></mxCell><mxCell id="fcm" value="&lt;b style=&quot;font-size:12px;color:#1f2933&quot;&gt;FCM&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;Push to supervisors and&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;admins: exits, rejections,&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;QR events.&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#fdf6e3;strokeColor=#9a6700;strokeWidth=1;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1158" y="764" width="224" height="90" as="geometry"/></mxCell><mxCell id="smtp" value="&lt;b style=&quot;font-size:12px;color:#1f2933&quot;&gt;SMTP  (nodemailer)&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;Invite codes plus the app&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;download link.&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#fdf6e3;strokeColor=#9a6700;strokeWidth=1;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1158" y="868" width="224" height="90" as="geometry"/></mxCell><mxCell id="fn" value="&lt;b style=&quot;font-size:12px;color:#1f2933&quot;&gt;Cloud Functions&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;notifyOnGeofence-&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;Anomaly&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;Firestore trigger that&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;pushes to FCM topic&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;&amp;quot;admins&amp;quot;.&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;OPTIONAL — needs the&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;Blaze plan. Undeployed&lt;/font&gt;&lt;br/&gt;&lt;font color=&quot;#5a6b7b&quot; style=&quot;font-size:10px&quot;&gt;it has zero effect.&lt;/font&gt;" style="rounded=1;arcSize=8;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=1;html=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1408" y="764" width="186" height="194" as="geometry"/></mxCell><mxCell id="b18" value="DEPLOYMENT  —  Kubernetes namespace  smartattendance" style="rounded=1;arcSize=4;fillColor=#f8fafc;strokeColor=#cbd5e1;dashed=1;dashPattern=6 4;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=11;fontStyle=1;fontColor=#5a6b7b;" vertex="1" parent="1"><mxGeometry x="40" y="1004" width="1580" height="100" as="geometry"/></mxCell><mxCell id="k1" value="&lt;b style=&quot;font-size:12px;color:#1f2933&quot;&g